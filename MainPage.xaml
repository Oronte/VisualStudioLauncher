<Page x:Class="VisualStudioLauncher.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisualStudioLauncher"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Page.Resources>
        <Style x:Key="MainPageButton" TargetType="Button">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>


                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#221d46"/>
                    <Setter Property="BorderBrush" Value="MediumPurple"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvisibleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>


                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontWeight" Value="DemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Visual Studio 2022" Foreground="White" Background="Transparent"
                   FontSize="23"/>

        <Grid Margin="0,35,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Open recent" FontSize="20" Foreground="White" Height="50" Width="150" HorizontalAlignment="Left"/>
            <local:SearchBarWidget Placeholder="Search recent (Alt+S)" Height="35" Width="350" HorizontalAlignment="Left" Margin="5,45,0,0"/>

            <Grid x:Name="recentProjects" Grid.Row="1" Background="Transparent" Margin="7, 20, 30, 0">

                <ListView ItemsSource="{Binding Projects}"
          SelectedItem="{Binding SelectedProject}"
          Background="Transparent"
          BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="HoverBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverBorder" Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="HoverBorder" Property="Background" Value="#2D2B55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.OpenCommand, 
                  RelativeSource={RelativeSource AncestorType=ListView}}"
        CommandParameter="{Binding}"
                    Style="{StaticResource InvisibleButton}"
                    HorizontalContentAlignment="Stretch">

                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                VerticalAlignment="Center"
                                Margin="6,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}"
                                   Foreground="#888888"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                               Text="{Binding Date}"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                                </Grid>

                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </Grid>
        </Grid>

        <StackPanel Orientation="Vertical" Grid.Column="1" Margin="15,30,0,0">
            <TextBlock Text="Get started" Foreground="White" Margin="15" FontSize="18"/>
            <Button Style="{StaticResource MainPageButton}" Height="75" Width="250" Margin="2">
                <Grid Width="225" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Views/CloneRepo.png" Width="25" Height="25"/>
                    <TextBlock Grid.Column="1" Text="Clone a repository" Foreground="White" FontSize="15" Margin="0,0,45,25" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Get code from an online repository like GitHub or Azure Devops" Foreground="White" FontSize="8" Margin="0, 25, 15, 10"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource MainPageButton}" Height="75" Width="250" Margin="2" Click="OpenLocalProject">
                <Grid Width="225" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                  

                    <Image Source="/Views/OpenProject.png" Width="25" Height="25"/>
                    <TextBlock Grid.Column="1" Text="Open a project or solution" Foreground="White" FontSize="15" Margin="0,0,0,25" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Open a local Visual Studio project or .sln file" Foreground="White" FontSize="8" Margin="0, 25, 15, 10"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource MainPageButton}" Height="75" Width="250" Margin="2" Click="OpenLocalProject">
                <Grid Width="225" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Views/OpenFolder.png" Width="25" Height="25"/>
                    <TextBlock Grid.Column="1" Text="Open a local folder" Foreground="White" FontSize="15" Margin="0,0,45,25" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Navigate and edit code within any folder" Foreground="White" FontSize="8" Margin="0, 25, 15, 10"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource MainPageButton}" Height="75" Width="250" Margin="2" Click="NavigateToTemplates">
                <Grid Width="225" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Views/CreateProject.png" Width="25" Height="25"/>
                    <TextBlock Grid.Column="1" Text="Create a new project" Foreground="White" FontSize="15" Margin="0,0,45,25" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Choose a project template with code scaffolding to get started" Foreground="White" FontSize="8" Margin="0, 25, 15, 10"/>
                </Grid>
            </Button>
            <Button Style="{StaticResource LinkButton}" Content="Continue whithout code ->" Foreground="CornflowerBlue" Margin="5" FontSize="10" HorizontalAlignment="Center" Background="Transparent" Click="OpenLocalProject"/>
        </StackPanel>
    </Grid>
</Page>
