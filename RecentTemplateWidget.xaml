<UserControl x:Class="VisualStudioLauncher.RecentTemplateWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisualStudioLauncher"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"></ColumnDefinition>
            <ColumnDefinition Width="60*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Image x:Name="TemplateIcon" Grid.Column="0" Width="20" Height="20" Margin="2,10,2,10" Source="{Binding Icon}" />
        <Label Grid.Column="1" Content="{Binding Name}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-10,0,0,0"></Label>
        <Border Grid.Column="2" CornerRadius="5" Background="#3D3D3D" VerticalAlignment="Center" Width="Auto" Height="20" Margin="0,0,25,0">
            <Label Content="{Binding Language}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="Transparent" Margin="0,-4,0,0"></Label>
        </Border>
        <!--<Button x:Name="TemplateButton" Width="Auto" Margin="80,0,109,0" Grid.Column="1" />-->
    </Grid>

</UserControl>
