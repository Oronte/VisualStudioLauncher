<Page x:Class="VisualStudioLauncher.ConfigureProjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisualStudioLauncher"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfigureProjectPage">

    <Grid>
        <StackPanel Orientation="Vertical" Background="Transparent" Margin="50, 100, 350, 150">
            <TextBlock Text="Project name" Foreground="White"/>
            <local:SearchBarWidget x:Name="projectName"/>
            <TextBlock Text="Location" Foreground="White"/>
            <StackPanel Orientation="Horizontal">
                <local:SearchBarWidget x:Name="location"  Width="375"/>
                <Button Content="..." Margin="5, 5, 5, 5" Width="20" Background="#2E2E2E" Foreground="White" Click="SearchProjectLocation"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
